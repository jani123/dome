// Package fixture is a real file backend used ONLY by container demonstration tests.
package fixture

import (
	"context"
	"errors"
	"fmt"
	"os"
	"path/filepath"

	"github.com/jani123/dome/core/resource"
)

type Backend struct{ Root string }

func (b Backend) Observe(ctx context.Context, n string) (resource.Snapshot, error) {
	if err := ctx.Err(); err != nil {
		return resource.Snapshot{}, err
	}
	p := filepath.Join(b.Root, n)
	info, err := os.Lstat(p)
	if errors.Is(err, os.ErrNotExist) {
		return resource.Snapshot{}, nil
	}
	if err != nil {
		return resource.Snapshot{}, err
	}
	if !info.Mode().IsRegular() {
		return resource.Snapshot{}, fmt.Errorf("fixture requires regular file")
	}
	data, err := os.ReadFile(p)
	return resource.Snapshot{Exists: true, Value: string(data)}, err
}

func (b Backend) Apply(ctx context.Context, n string, a resource.Action, s resource.Snapshot) error {
	if err := ctx.Err(); err != nil {
		return err
	}
	if _, err := b.Observe(ctx, n); err != nil {
		return err
	}
	p := filepath.Join(b.Root, n)
	if a == resource.Delete {
		err := os.Remove(p)
		if errors.Is(err, os.ErrNotExist) {
			return nil
		}
		return err
	}
	return os.WriteFile(p, []byte(s.Value), 0o600)
}
