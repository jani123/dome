//go:build ignore

package main

import (
	"fmt"
	"os"

	"golang.org/x/mod/module"
	"golang.org/x/mod/semver"
)

func main() {
	if len(os.Args) != 2 || !semver.IsValid(os.Args[1]) || semver.Canonical(os.Args[1]) != os.Args[1] || semver.Build(os.Args[1]) != "" || module.IsPseudoVersion(os.Args[1]) || module.Check("example.com/__MODULE__", os.Args[1]) != nil {
		fmt.Fprintln(os.Stderr, "invalid canonical module release version")
		os.Exit(1)
	}
}
